{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "process",
      "command": "python",
      "args": [
        "tools/build.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "xc8",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+)?:?\\s*(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Test firmware (emulator)",
      "type": "process",
      "command": "python",
      "args": [
        "tools/test_open.py"
      ],
      "dependsOn": "Build",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Probe stock firmware pins (emulator)",
      "type": "process",
      "command": "python",
      "args": [
        "tools/stock_probe.py"
      ],
      "problemMatcher": []
    }
  ]
}
