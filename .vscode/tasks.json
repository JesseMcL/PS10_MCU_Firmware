{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build factory firmware",
      "type": "process",
      "command": "python",
      "args": ["tools/build.py"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "gpasm",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(Error|Warning|Message)\\[\\d+\\]\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    },
    {
      "label": "Test factory firmware (emulator)",
      "type": "process",
      "command": "python",
      "args": ["tools/test_factory.py"],
      "dependsOn": "Build factory firmware",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Probe stock firmware pins (emulator)",
      "type": "process",
      "command": "python",
      "args": ["tools/stock_probe.py"],
      "problemMatcher": []
    }
  ]
}
